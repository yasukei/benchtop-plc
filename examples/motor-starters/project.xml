<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0201" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:panel="https://github.com/yasukei/benchtop-plc/ns/panel/1" xmlns:source="https://github.com/yasukei/benchtop-plc/ns/source/1"><fileHeader companyName="benchtop-plc" productName="benchtop-plc" productVersion="0.3.0" creationDateTime="2026-10-23T00:00:00Z"/><contentHeader name="Motor starters" language="en"><coordinateInfo><fbd><scaling x="1" y="1"/></fbd><ld><scaling x="1" y="1"/></ld><sfc><scaling x="1" y="1"/></sfc></coordinateInfo></contentHeader><types><dataTypes/><pous><pou name="Main" pouType="program"><interface><localVars><variable name="Start1" address="%IX0.0"><type><BOOL/></type></variable><variable name="Stop1" address="%IX0.1"><type><BOOL/></type></variable><variable name="Overload1" address="%IX0.2"><type><BOOL/></type></variable><variable name="Start2" address="%IX0.3"><type><BOOL/></type></variable><variable name="Stop2" address="%IX0.4"><type><BOOL/></type></variable><variable name="Overload2" address="%IX0.5"><type><BOOL/></type></variable><variable name="Run1" address="%QX0.0"><type><BOOL/></type></variable><variable name="Starting1" address="%QX0.1"><type><BOOL/></type></variable><variable name="Trip1" address="%QX0.2"><type><BOOL/></type></variable><variable name="Run2" address="%QX0.3"><type><BOOL/></type></variable><variable name="Starting2" address="%QX0.4"><type><BOOL/></type></variable><variable name="Trip2" address="%QX0.5"><type><BOOL/></type></variable><variable name="M1"><type><derived name="MOTORSTARTER"/></type></variable><variable name="M2"><type><derived name="MOTORSTARTER"/></type></variable></localVars></interface><body><ST><xhtml:p>&#10;&#10;(* Reserve the interlock during the delay as well as while running.&#10;   Calling M1 first gives it priority when both motors are idle. *)&#10;M1(Start := CanStart(Start1, M2.Active), Stop := Stop1,&#10;   Overload := Overload1, Delay := T#500ms,&#10;   Running =&gt; Run1, Tripped =&gt; Trip1);&#10;M2(Start := CanStart(Start2, M1.Active), Stop := Stop2,&#10;   Overload := Overload2, Delay := T#500ms,&#10;   Running =&gt; Run2, Tripped =&gt; Trip2);&#10;&#10;Starting1 := M1.Active AND NOT M1.Running;&#10;Starting2 := M2.Active AND NOT M2.Running;&#10;</xhtml:p></ST></body><addData><data name="https://github.com/yasukei/benchtop-plc/ns/source/1" handleUnknown="discard"><source:source version="1">PROGRAM Main&#10;VAR&#10;    Start1 AT %IX0.0 : BOOL;&#10;    Stop1 AT %IX0.1 : BOOL;&#10;    Overload1 AT %IX0.2 : BOOL;&#10;    Start2 AT %IX0.3 : BOOL;&#10;    Stop2 AT %IX0.4 : BOOL;&#10;    Overload2 AT %IX0.5 : BOOL;&#10;    Run1 AT %QX0.0 : BOOL;&#10;    Starting1 AT %QX0.1 : BOOL;&#10;    Trip1 AT %QX0.2 : BOOL;&#10;    Run2 AT %QX0.3 : BOOL;&#10;    Starting2 AT %QX0.4 : BOOL;&#10;    Trip2 AT %QX0.5 : BOOL;&#10;    M1 : MotorStarter;&#10;    M2 : MotorStarter;&#10;END_VAR&#10;&#10;(* Reserve the interlock during the delay as well as while running.&#10;   Calling M1 first gives it priority when both motors are idle. *)&#10;M1(Start := CanStart(Start1, M2.Active), Stop := Stop1,&#10;   Overload := Overload1, Delay := T#500ms,&#10;   Running =&gt; Run1, Tripped =&gt; Trip1);&#10;M2(Start := CanStart(Start2, M1.Active), Stop := Stop2,&#10;   Overload := Overload2, Delay := T#500ms,&#10;   Running =&gt; Run2, Tripped =&gt; Trip2);&#10;&#10;Starting1 := M1.Active AND NOT M1.Running;&#10;Starting2 := M2.Active AND NOT M2.Running;&#10;END_PROGRAM&#10;</source:source></data></addData></pou><pou name="MotorStarter" pouType="functionBlock"><interface><inputVars><variable name="Start"><type><BOOL/></type></variable><variable name="Stop"><type><BOOL/></type></variable><variable name="Overload"><type><BOOL/></type></variable><variable name="Delay"><type><TIME/></type><initialValue><simpleValue value="T#500ms"/></initialValue></variable></inputVars><outputVars><variable name="Active"><type><BOOL/></type></variable><variable name="Running"><type><BOOL/></type></variable><variable name="Tripped"><type><BOOL/></type></variable></outputVars><localVars><variable name="StartTimer"><type><derived name="TON"/></type></variable></localVars></interface><body><ST><xhtml:p>&#10;&#10;(* STOP and overload take priority over START and clear the latch. *)&#10;Active := (Start OR Active) AND NOT Stop AND NOT Overload;&#10;StartTimer(IN := Active, PT := Delay);&#10;Running := StartTimer.Q;&#10;Tripped := Overload;&#10;</xhtml:p></ST></body><addData><data name="https://github.com/yasukei/benchtop-plc/ns/source/1" handleUnknown="discard"><source:source version="1">FUNCTION_BLOCK MotorStarter&#10;VAR_INPUT&#10;    Start : BOOL;&#10;    Stop : BOOL;&#10;    Overload : BOOL;&#10;    Delay : TIME := T#500ms;&#10;END_VAR&#10;VAR_OUTPUT&#10;    Active : BOOL;&#10;    Running : BOOL;&#10;    Tripped : BOOL;&#10;END_VAR&#10;VAR&#10;    StartTimer : TON;&#10;END_VAR&#10;&#10;(* STOP and overload take priority over START and clear the latch. *)&#10;Active := (Start OR Active) AND NOT Stop AND NOT Overload;&#10;StartTimer(IN := Active, PT := Delay);&#10;Running := StartTimer.Q;&#10;Tripped := Overload;&#10;END_FUNCTION_BLOCK&#10;</source:source></data></addData></pou><pou name="CanStart" pouType="function"><interface><returnType><BOOL/></returnType><inputVars><variable name="Requested"><type><BOOL/></type></variable><variable name="OtherActive"><type><BOOL/></type></variable></inputVars></interface><body><ST><xhtml:p>&#10;&#10;CanStart := Requested AND NOT OtherActive;&#10;</xhtml:p></ST></body><addData><data name="https://github.com/yasukei/benchtop-plc/ns/source/1" handleUnknown="discard"><source:source version="1">FUNCTION CanStart : BOOL&#10;VAR_INPUT&#10;    Requested : BOOL;&#10;    OtherActive : BOOL;&#10;END_VAR&#10;&#10;CanStart := Requested AND NOT OtherActive;&#10;END_FUNCTION&#10;</source:source></data></addData></pou></pous></types><instances><configurations><configuration name="Config"><resource name="Res"><task name="Cyclic" interval="PT0.01S" priority="1"><pouInstance name="mainInstance" typeName="Main"/></task></resource></configuration></configurations></instances><addData><data name="https://github.com/yasukei/benchtop-plc/ns/panel/1" handleUnknown="discard"><panel:panel version="1">[{&quot;id&quot;:&quot;m1-start&quot;,&quot;kind&quot;:&quot;pushbutton&quot;,&quot;label&quot;:&quot;M1 START&quot;,&quot;bit&quot;:0,&quot;color&quot;:&quot;green&quot;,&quot;x&quot;:0,&quot;y&quot;:0},{&quot;id&quot;:&quot;m1-stop&quot;,&quot;kind&quot;:&quot;pushbutton&quot;,&quot;label&quot;:&quot;M1 STOP&quot;,&quot;bit&quot;:1,&quot;color&quot;:&quot;red&quot;,&quot;x&quot;:0.3333333333333333,&quot;y&quot;:0},{&quot;id&quot;:&quot;m1-overload&quot;,&quot;kind&quot;:&quot;selector&quot;,&quot;label&quot;:&quot;M1 OVERLOAD&quot;,&quot;bit&quot;:2,&quot;color&quot;:&quot;black&quot;,&quot;x&quot;:0,&quot;y&quot;:0.5},{&quot;id&quot;:&quot;m1-trip&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M1 TRIP&quot;,&quot;bit&quot;:2,&quot;color&quot;:&quot;red&quot;,&quot;x&quot;:0.3333333333333333,&quot;y&quot;:0.5},{&quot;id&quot;:&quot;m1-starting&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M1 STARTING&quot;,&quot;bit&quot;:1,&quot;color&quot;:&quot;amber&quot;,&quot;x&quot;:0,&quot;y&quot;:1},{&quot;id&quot;:&quot;m1-run&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M1 RUN&quot;,&quot;bit&quot;:0,&quot;color&quot;:&quot;green&quot;,&quot;x&quot;:0.3333333333333333,&quot;y&quot;:1},{&quot;id&quot;:&quot;m2-start&quot;,&quot;kind&quot;:&quot;pushbutton&quot;,&quot;label&quot;:&quot;M2 START&quot;,&quot;bit&quot;:3,&quot;color&quot;:&quot;green&quot;,&quot;x&quot;:0.6666666666666666,&quot;y&quot;:0},{&quot;id&quot;:&quot;m2-stop&quot;,&quot;kind&quot;:&quot;pushbutton&quot;,&quot;label&quot;:&quot;M2 STOP&quot;,&quot;bit&quot;:4,&quot;color&quot;:&quot;red&quot;,&quot;x&quot;:1,&quot;y&quot;:0},{&quot;id&quot;:&quot;m2-overload&quot;,&quot;kind&quot;:&quot;selector&quot;,&quot;label&quot;:&quot;M2 OVERLOAD&quot;,&quot;bit&quot;:5,&quot;color&quot;:&quot;black&quot;,&quot;x&quot;:0.6666666666666666,&quot;y&quot;:0.5},{&quot;id&quot;:&quot;m2-trip&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M2 TRIP&quot;,&quot;bit&quot;:5,&quot;color&quot;:&quot;red&quot;,&quot;x&quot;:1,&quot;y&quot;:0.5},{&quot;id&quot;:&quot;m2-starting&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M2 STARTING&quot;,&quot;bit&quot;:4,&quot;color&quot;:&quot;amber&quot;,&quot;x&quot;:0.6666666666666666,&quot;y&quot;:1},{&quot;id&quot;:&quot;m2-run&quot;,&quot;kind&quot;:&quot;led&quot;,&quot;label&quot;:&quot;M2 RUN&quot;,&quot;bit&quot;:3,&quot;color&quot;:&quot;green&quot;,&quot;x&quot;:1,&quot;y&quot;:1}]</panel:panel></data></addData></project>