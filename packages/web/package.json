{
  "name": "@benchtop-plc/web",
  "version": "0.0.0",
  "private": true,
  "description": "Browser UI; hosts the runtime in a Web Worker.",
  "type": "module",
  "exports": {
    ".": {
      "@benchtop-plc/source": "./src/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@benchtop-plc/compiler": "workspace:*",
    "@benchtop-plc/core": "workspace:*",
    "@benchtop-plc/project": "workspace:*",
    "@benchtop-plc/runtime": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
