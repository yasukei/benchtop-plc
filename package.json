{
  "name": "benchtop-plc",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based software PLC aiming at IEC 61131-3 compliance.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @benchtop-plc/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . && depcruise packages tests && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "devDependencies": {
    "@benchtop-plc/compiler": "workspace:*",
    "@benchtop-plc/core": "workspace:*",
    "@benchtop-plc/project": "workspace:*",
    "@benchtop-plc/runtime": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "libxml2-wasm": "^0.7.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
