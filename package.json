{
  "name": "benchtop-plc",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-based software PLC aiming at IEC 61131-3 compliance.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @benchtop-plc/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . && depcruise packages tests && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "node -e \"console.log('No end-to-end tests yet; Playwright is added with issue #12.')\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
