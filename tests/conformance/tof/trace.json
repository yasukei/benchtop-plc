{
  "kind": "run",
  "cycleMs": 1,
  "steps": [
    {
      "label": "Initial false does not start delay",
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "True turns on immediately",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "Falling edge starts delay",
      "set": {
        "mainInstance.Input": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "PT minus one",
      "advanceMs": 9,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 9
      }
    },
    {
      "label": "PT boundary",
      "advanceMs": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 10
      }
    },
    {
      "label": "True resets elapsed",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 0
      }
    }
  ]
}
