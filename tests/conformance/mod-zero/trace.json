{
  "kind": "run",
  "cycleMs": 10,
  "steps": [
    {
      "label": "Constant MOD zero initializes to zero",
      "expect": {
        "mainInstance.InitialSmall": 0,
        "mainInstance.InitialLarge": 0,
        "mainInstance.SmallRemainder": 99,
        "mainInstance.LargeRemainder": 99
      }
    },
    {
      "label": "Positive INT and DINT dividends with a zero divisor stay in RUN",
      "scans": 1,
      "expect": {
        "mainInstance.SmallRemainder": 0,
        "mainInstance.LargeRemainder": 0
      }
    },
    {
      "label": "Negative INT and DINT dividends with a zero divisor stay in RUN",
      "set": {
        "mainInstance.Small": -7,
        "mainInstance.Large": -40000
      },
      "scans": 2,
      "expect": {
        "mainInstance.SmallRemainder": 0,
        "mainInstance.LargeRemainder": 0
      }
    },
    {
      "label": "Nonzero divisors still use the dividend sign",
      "set": {
        "mainInstance.Divisor": 3
      },
      "scans": 1,
      "expect": {
        "mainInstance.SmallRemainder": -1,
        "mainInstance.LargeRemainder": -1
      }
    }
  ]
}
