{
  "kind": "run",
  "cycleMs": 1,
  "steps": [
    {
      "label": "Initially high starts pulse",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "Falling edge does not end pulse",
      "set": {
        "mainInstance.Input": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 1
      }
    },
    {
      "label": "PT minus one",
      "advanceMs": 8,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 9
      }
    },
    {
      "label": "PT boundary with input high",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 10
      }
    },
    {
      "label": "Held high does not retrigger",
      "scans": 5,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 10
      }
    },
    {
      "label": "False rearms",
      "set": {
        "mainInstance.Input": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "Next rising edge starts a new pulse",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 0
      }
    }
  ]
}
