{
  "kind": "run",
  "cycleMs": 10,
  "steps": [
    {
      "label": "Initial counts",
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 0,
        "mainInstance.Up.Q": false,
        "mainInstance.Down.CV": 0,
        "mainInstance.Down.Q": true
      }
    },
    {
      "label": "Load down counter",
      "set": {
        "mainInstance.Load": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Down.CV": 2,
        "mainInstance.Down.Q": false
      }
    },
    {
      "label": "First edge",
      "set": {
        "mainInstance.Load": false,
        "mainInstance.Edge": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 1,
        "mainInstance.Down.CV": 1
      }
    },
    {
      "label": "Held edge counts once",
      "scans": 3,
      "expect": {
        "mainInstance.Up.CV": 1,
        "mainInstance.Down.CV": 1
      }
    },
    {
      "label": "Release edge",
      "set": {
        "mainInstance.Edge": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 1,
        "mainInstance.Down.CV": 1
      }
    },
    {
      "label": "Second edge reaches thresholds",
      "set": {
        "mainInstance.Edge": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 2,
        "mainInstance.Up.Q": true,
        "mainInstance.Down.CV": 0,
        "mainInstance.Down.Q": true
      }
    },
    {
      "label": "Release edge before simultaneous controls and count edge",
      "set": {
        "mainInstance.Edge": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 2,
        "mainInstance.Up.Q": true,
        "mainInstance.Down.CV": 0,
        "mainInstance.Down.Q": true
      }
    },
    {
      "label": "Reset and load take priority over a simultaneous count edge",
      "set": {
        "mainInstance.Edge": true,
        "mainInstance.Reset": true,
        "mainInstance.Load": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 0,
        "mainInstance.Up.Q": false,
        "mainInstance.Down.CV": 2,
        "mainInstance.Down.Q": false
      }
    },
    {
      "label": "Release controls on held high does not count",
      "set": {
        "mainInstance.Reset": false,
        "mainInstance.Load": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Up.CV": 0,
        "mainInstance.Down.CV": 2
      }
    }
  ]
}
