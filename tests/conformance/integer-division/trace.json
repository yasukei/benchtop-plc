{
  "kind": "run",
  "cycleMs": 10,
  "steps": [
    {
      "label": "Negative dividend truncates toward zero",
      "scans": 1,
      "expect": {
        "mainInstance.Quotient": -3,
        "mainInstance.Remainder": -1
      }
    },
    {
      "label": "Negative divisor preserves dividend remainder sign",
      "set": {
        "mainInstance.Dividend": 7,
        "mainInstance.Divisor": -2
      },
      "scans": 1,
      "expect": {
        "mainInstance.Quotient": -3,
        "mainInstance.Remainder": 1
      }
    },
    {
      "label": "Both negative",
      "set": {
        "mainInstance.Dividend": -7
      },
      "scans": 1,
      "expect": {
        "mainInstance.Quotient": 3,
        "mainInstance.Remainder": -1
      }
    }
  ]
}
