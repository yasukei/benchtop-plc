{
  "kind": "run",
  "cycleMs": 1,
  "steps": [
    {
      "label": "Initially reset",
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "Start delay",
      "set": {
        "mainInstance.Input": true
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 0
      }
    },
    {
      "label": "PT minus one",
      "advanceMs": 9,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 9
      }
    },
    {
      "label": "PT boundary",
      "advanceMs": 1,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 10
      }
    },
    {
      "label": "Completed timer stays on",
      "scans": 5,
      "expect": {
        "mainInstance.Output": true,
        "mainInstance.Timer.ET": 10
      }
    },
    {
      "label": "False resets timer",
      "set": {
        "mainInstance.Input": false
      },
      "scans": 1,
      "expect": {
        "mainInstance.Output": false,
        "mainInstance.Timer.ET": 0
      }
    }
  ]
}
