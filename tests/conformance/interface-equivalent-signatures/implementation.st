FUNCTION_BLOCK DeviceImpl IMPLEMENTS IDevice
METHOD PUBLIC Count : AliasInt
  VAR_INPUT delta: AliasInt; text: STRING[10]; END_VAR
  Count := delta + STRING_TO_INT(text);
END_METHOD
METHOD PUBLIC Format : STRING[10]
  VAR_INPUT delta: AliasInt; text: STRING[10]; END_VAR
  Format := CONCAT(text, INT_TO_STRING(delta));
END_METHOD
END_FUNCTION_BLOCK
