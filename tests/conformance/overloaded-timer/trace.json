{
  "kind": "run",
  "cycleMs": 0.5,
  "steps": [
    {
      "label": "Start the inferred LTIME timer",
      "scans": 1,
      "expect": {
        "mainInstance.timer.Q": false,
        "mainInstance.elapsedIsPreset": false
      }
    },
    {
      "label": "One millisecond has elapsed",
      "scans": 2,
      "expect": {
        "mainInstance.timer.Q": false,
        "mainInstance.elapsedIsPreset": false
      }
    },
    {
      "label": "Reach the 1.5 ms preset exactly",
      "scans": 1,
      "expect": {
        "mainInstance.timer.Q": true,
        "mainInstance.elapsedIsPreset": true
      }
    }
  ]
}
