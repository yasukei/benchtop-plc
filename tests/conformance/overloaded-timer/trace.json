{
  "kind": "run",
  "cycleMs": 0.5,
  "steps": [
    {
      "label": "Start the inferred LTIME timer",
      "scans": 1,
      "expect": { "timer.Q": false, "elapsedIsPreset": false }
    },
    {
      "label": "One millisecond has elapsed",
      "scans": 2,
      "expect": { "timer.Q": false, "elapsedIsPreset": false }
    },
    {
      "label": "Reach the 1.5 ms preset exactly",
      "scans": 1,
      "expect": { "timer.Q": true, "elapsedIsPreset": true }
    }
  ]
}
